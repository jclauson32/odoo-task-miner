<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_apply_po_terms" model="ir.ui.view">
        <field name="name">account.move.form.inherit.apply.po.terms</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post' and @invisible=&quot;hide_post_button or move_type == 'entry' or display_inactive_currency_warning&quot;]" position="before">
                <button name="action_apply_po_terms" string="Apply PO Terms"
                        type="object" class="btn-secondary"
                        groups="account.group_account_invoice"
                        confirm="Lines with no matching purchase order line will be removed from the bill. Continue?"
                        invisible="state != 'draft' or move_type != 'in_invoice'"/>
            </xpath>
        </field>
    </record>
</odoo>
