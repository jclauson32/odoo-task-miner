{
    "title": "bill-exception-review",
    "steps": [
        {
            "type": "setViewport",
            "width": 1365,
            "height": 919,
            "deviceScaleFactor": 1,
            "isMobile": false,
            "hasTouch": false,
            "isLandscape": false
        },
        {
            "type": "navigate",
            "url": "http://localhost:8069/web/login?redirect=%2Fodoo%2Fbills",
            "assertedEvents": [
                {
                    "type": "navigation",
                    "url": "http://localhost:8069/web/login?redirect=%2Fodoo%2Fbills",
                    "title": "Odoo"
                }
            ]
        },
        {
            "type": "change",
            "value": "admin",
            "selectors": [
                [
                    "aria/Email"
                ],
                [
                    "#login"
                ],
                [
                    "xpath///*[@id=\"login\"]"
                ],
                [
                    "pierce/#login"
                ]
            ],
            "target": "main"
        },
        {
            "type": "change",
            "value": "admin",
            "selectors": [
                [
                    "aria/Password Reset Password"
