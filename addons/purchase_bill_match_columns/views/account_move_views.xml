<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_purchase_bill_match_columns" model="ir.ui.view">
        <field name="name">account.move.inherit.purchase.bill.match.columns</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="purchase.view_move_form_inherit_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='purchase_order_id']" position="after">
                <field name="po_line_product_qty" groups="purchase.group_purchase_user" optional="show" readonly="1" column_invisible="parent.move_type != 'in_invoice'"/>
                <field name="po_line_qty_received" groups="purchase.group_purchase_user" optional="show" readonly="1" column_invisible="parent.move_type != 'in_invoice'"/>
                <field name="po_line_price_unit" groups="purchase.group_purchase_user" optional="show" readonly="1" column_invisible="parent.move_type != 'in_invoice'"/>
            </xpath>
        </field>
    </record>
</odoo>
