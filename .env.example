# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# LangSmith: with tracing on, every LangChain/LangGraph/Deep Agents call is traced.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=odoo-miner

# Models (provider:model). The fast model is for subagents and cheap checks.
ODOO_MINER_MODEL=anthropic:claude-sonnet-5-5
ODOO_MINER_FAST_MODEL=anthropic:claude-haiku-4-5-20251001

# Odoo 18 source checkout for the agents to read (git clone -b 18.0 … vendor/odoo)
ODOO_SOURCE=vendor/odoo

# builder_agent delivery
GIT_REMOTE=origin
REPORT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
