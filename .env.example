# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# LangSmith: with tracing on, every LangChain/LangGraph/Deep Agents call is traced.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=odoo-miner

# Models (provider:model). The fast model is for subagents and cheap checks.
ODOO_MINER_MODEL=anthropic:claude-sonnet-5
ODOO_MINER_FAST_MODEL=anthropic:claude-haiku-4-5

# Odoo 18 source checkout for the agents to read (git clone -b 18.0 … vendor/odoo)
ODOO_SOURCE=vendor/odoo

# builder_agent delivery. Pull requests go to the GitHub repository behind
# GIT_REMOTE; branches are always feat/<module>, never PR_BASE.
GIT_REMOTE=origin
PR_BASE=main

# Reports go only to this address; the agent cannot choose another.
REPORT_EMAIL_TO=
# Port 465 or SMTP_SSL=true means implicit TLS; otherwise STARTTLS is required.
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
# Sender shown on the email, e.g. "Odoo Miner <reports@example.com>".
SMTP_FROM=

# Append-only log of approvals and outward actions.
ODOO_MINER_AUDIT_LOG=out/audit.jsonl
